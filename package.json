{
  "name": "openwa-worker",
  "version": "0.1.0",
  "private": true,
  "description": "OpenWA WhatsApp gateway for Cloudflare Workers — baileys connection layer + minimal API, UI-agnostic (bring your own static frontend).",
  "scripts": {
    "postinstall": "node scripts/patch-baileys-worker-socket.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/patch-baileys-worker-socket.spec.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.129.0"
  }
}